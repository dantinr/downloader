<Window x:Class="BigFileDownloader.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="500"
        Height="286"
        MinWidth="400"
        MinHeight="260"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Closing="Window_Closing">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold" />

        <Label Grid.Row="2"
               Target="{Binding ElementName=DefaultDirectoryBox}"
               Content="默认下载位置"
               Padding="0"
               FontSize="12"
               Foreground="{StaticResource MutedTextBrush}" />

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="DefaultDirectoryBox"
                     AutomationProperties.Name="默认下载位置"
                     AutomationProperties.HelpText="{Binding Text, ElementName=ErrorText}"
                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                     TextChanged="DefaultDirectoryBox_TextChanged" />
            <Button x:Name="BrowseButton"
                    Grid.Column="2"
                    Style="{StaticResource IconButton}"
                    Content="&#xE8B7;"
                    ToolTip="选择默认下载文件夹"
                    AutomationProperties.Name="选择默认下载文件夹"
                    Click="BrowseButton_Click" />
        </Grid>

        <StackPanel Grid.Row="5" Margin="0,7,0,0">
            <TextBlock Text="仅影响新任务，现有任务及文件不会移动。"
                       FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}" />
            <TextBlock x:Name="ErrorText"
                       Visibility="Collapsed"
                       Margin="0,6,0,0"
                       FontSize="11"
                       Foreground="{StaticResource DangerBrush}"
                       AutomationProperties.LiveSetting="Assertive"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="RestoreDefaultButton"
                    Style="{StaticResource SecondaryButton}"
                    MinWidth="104"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="恢复默认下载位置"
                    Click="RestoreDefaultButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,7,0" />
                    <TextBlock Text="恢复默认" />
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CancelButton"
                        Style="{StaticResource SecondaryButton}"
                        Content="取消"
                        MinWidth="76"
                        IsCancel="True" />
                <Button x:Name="SaveButton"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="84"
                        Margin="8,0,0,0"
                        IsDefault="True"
                        AutomationProperties.Name="保存设置"
                        Click="SaveButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,7,0" />
                        <TextBlock Text="保存" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
