<Window x:Class="BigFileDownloader.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于"
        Width="500"
        Height="328"
        MinWidth="480"
        MinHeight="300"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="1" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Border Width="44" Height="44" CornerRadius="6" Background="#EAF1FF" Margin="0,0,14,0">
                <TextBlock Text="&#xE896;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="22"
                           Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ProductNameText" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText"
                           Margin="0,3,0,0"
                           FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="2"
                   x:Name="DescriptionText"
                   FontSize="13"
                   TextWrapping="Wrap" />

        <Border Grid.Row="4" Background="{StaticResource BorderBrush}" />

        <Grid Grid.Row="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="开源协议" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
            <TextBlock Grid.Column="1" x:Name="LicenseText" FontSize="12" />
            <TextBlock Grid.Row="1" Text="项目地址" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,0" />
            <TextBlock Grid.Row="1"
                       Grid.Column="1"
                       x:Name="RepositoryText"
                       Margin="0,12,0,0"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Grid>

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}"
                        AutomationProperties.Name="打开 GitHub 项目主页"
                        Click="RepositoryButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,7,0" />
                        <TextBlock Text="项目主页" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="查看 Apache 2.0 许可证"
                        Click="LicenseButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,7,0" />
                        <TextBlock Text="查看许可证" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}"
                        MinWidth="102"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="复制诊断信息"
                        Click="CopyDiagnosticsButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,7,0" />
                        <TextBlock x:Name="CopyDiagnosticsText"
                                   Text="复制信息"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Button x:Name="CloseButton"
                    Grid.Column="1"
                    Style="{StaticResource PrimaryButton}"
                    Content="关闭"
                    MinWidth="72"
                    Margin="12,0,0,0"
                    IsCancel="True" />
        </Grid>
    </Grid>
</Window>
