<Window x:Class="BigFileDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:BigFileDownloader.Converters"
        Title="downloader"
        Width="1180"
        Height="720"
        MinWidth="920"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <converters:DownloadStateBrushConverter x:Key="StateBrushConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,17">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="6" Background="#EAF1FF" Margin="0,0,12,0">
                        <TextBlock Text="&#xE896;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="18"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="downloader" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="可靠下载与断点续传" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="并发连接" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="SegmentBox" Width="76" SelectedIndex="2">
                        <ComboBoxItem Content="1" Tag="1" />
                        <ComboBoxItem Content="2" Tag="2" />
                        <ComboBoxItem Content="4" Tag="4" />
                        <ComboBoxItem Content="8" Tag="8" />
                        <ComboBoxItem Content="12" Tag="12" />
                        <ComboBoxItem Content="16" Tag="16" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="下载地址" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="1,0,0,5" />
                    <TextBox x:Name="UrlBox"
                             AutomationProperties.Name="下载地址"
                             KeyDown="UrlBox_KeyDown" />
                </StackPanel>
                <Button Grid.Row="0" Grid.Column="2"
                        x:Name="AddButton"
                        Style="{StaticResource PrimaryButton}"
                        Height="36"
                        Margin="0,22,0,0"
                        Click="AddButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,7,0" />
                        <TextBlock Text="添加下载" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="保存位置" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="1,0,0,5" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderBox" AutomationProperties.Name="保存位置" />
                        <Button Grid.Column="2"
                                Style="{StaticResource IconButton}"
                                Content="&#xE838;"
                                ToolTip="选择保存文件夹"
                                Click="BrowseButton_Click" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="24,18,24,16" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="#FFFFFF">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="12,8" VerticalAlignment="Center">
                        <Button x:Name="PauseButton" Style="{StaticResource IconButton}" Content="&#xE769;" ToolTip="暂停" Click="PauseButton_Click" />
                        <Button x:Name="ResumeButton" Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="继续" Click="ResumeButton_Click" Margin="7,0,0,0" />
                        <Button x:Name="RetryButton" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="重试" Click="RetryButton_Click" Margin="7,0,0,0" />
                        <Border Width="1" Height="22" Background="{StaticResource BorderBrush}" Margin="11,0" />
                        <Button x:Name="OpenButton" Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="打开所在文件夹" Click="OpenButton_Click" />
                        <Button x:Name="RemoveButton" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="移除任务" Click="RemoveButton_Click" Margin="7,0,0,0" />
                        <Button x:Name="LogButton" Style="{StaticResource IconButton}" Content="&#xE8A5;" ToolTip="打开诊断日志" Click="LogButton_Click" Margin="7,0,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            x:Name="ClearCompletedButton"
                            Style="{StaticResource SecondaryButton}"
                            Content="清理已完成"
                            Margin="0,8,12,8"
                            Click="ClearCompletedButton_Click" />
                </Grid>

                <Grid Grid.Row="1">
                    <DataGrid x:Name="QueueGrid"
                              ItemsSource="{Binding Jobs}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              AlternationCount="2"
                              SelectionChanged="QueueGrid_SelectionChanged"
                              MouseDoubleClick="QueueGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="文件" Width="2.2*" MinWidth="230">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" ToolTip="{Binding Url}">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="大小" Binding="{Binding SizeDisplay}" Width="100" />
                            <DataGridTemplateColumn Header="进度" Width="1.5*" MinWidth="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="7" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <TextBlock Text="{Binding ProgressDisplay}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Text="{Binding DownloadedDisplay}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar Grid.Row="2"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Value="{Binding ProgressPercent}"
                                                         IsIndeterminate="{Binding IsIndeterminate}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="速度" Binding="{Binding SpeedDisplay}" Width="105" />
                            <DataGridTextColumn Header="剩余" Binding="{Binding EtaDisplay}" Width="85" />
                            <DataGridTextColumn Header="连接" Binding="{Binding SegmentCount}" Width="64" />
                            <DataGridTemplateColumn Header="状态" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StateDisplay}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding State, Converter={StaticResource StateBrushConverter}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" FontSize="30" Foreground="#9AA4AF" HorizontalAlignment="Center" />
                        <TextBlock Text="暂无下载任务" FontSize="14" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#EEF1F4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SummaryText" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Grid.Column="1" x:Name="StorageText" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
